{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mox",
  "version": "0.3.0",
  "identifier": "dev.moxart.moxdl",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mox",
        "width": 1040,
        "height": 680,
        "minWidth": 720,
        "minHeight": 440,
        "backgroundColor": "#141113",
        "center": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "A fast, resumable, multi-connection download manager",
    "longDescription": "The desktop app for Mox: downloads over many connections, resumes after a pause, a reboot or an outage, and lets you choose what downloads first.",
    "publisher": "Patrick Der Avakians",
    "copyright": "MIT License",
    "homepage": "https://github.com/moxart/moxdl-desktop",
    "license": "MIT"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "mox"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwQzQ3MjFEMTYyREJENEMKUldSTXZTMFdIWExFTUhTbE02MmxWWGRFMFpNSFB3YjQxU1hiaCtXaVpQdWp0QjUvM3RYblkxaWQK",
      "endpoints": [
        "https://github.com/moxart/moxdl-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
